[Unit]
Description=DocServer – lokale Context7-Alternative (FastAPI + MCP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/docserver/app
EnvironmentFile=/opt/docserver/config.env
ExecStart=/opt/docserver/venv/bin/uvicorn app:app --host 0.0.0.0 --port ${PORT}
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
